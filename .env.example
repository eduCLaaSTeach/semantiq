APP_NAME=SemantIQ
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=semantiq
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Declared, NOT required in P1-BASE. P1-00 activates Microsoft authentication and
# promotes these into the required set. They stay empty until then: a placeholder
# value would move the failure from boot, where it is obvious, to the identity
# provider, where it is not.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# Microsoft Entra ID (P1-00). Values live only in the server .env - never here,
# never in CI, never in a page payload. Required in production; absent elsewhere,
# where the provider simply reports itself unconfigured.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
