# SemantIQ cPanel front door.
#
# Used when the document root is public_html and the whole Laravel tree is
# deployed inside it (D-08B). Where cPanel allows the document root to be set to
# public_html/public (D-08A), the application tree sits outside the web root and
# this file remains only as defence against an accidental future document-root
# change - not as the primary boundary.
#
# TWO independent guards. The rewrite at the bottom sends every request into
# public/; the deny rules above refuse the sensitive paths outright. Either alone
# would do the job today. Together, neither one failing quietly exposes a
# credential - and what is behind the door is a database password and, from
# P1-00, a Microsoft client secret.
#
# No RewriteBase, domain or absolute path, so the same file works across domains
# and subdomains.

# ---------------------------------------------------------------------------
# Guard one: refuse the sensitive paths outright.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # .well-known must stay reachable: it carries the ACME challenge that renews
    # the TLS certificate. Blocking it breaks HTTPS renewal silently, weeks
    # later, in a way nobody connects back to this file. It is matched FIRST,
    # before the dotfile rule below would otherwise catch it.
    RewriteRule ^\.well-known/ - [L]

    # Every other dotfile.
    RewriteRule (^|/)\. - [F,L]
</IfModule>

# Matched by name as well as by directory, so a file that moves does not quietly
# lose its guard.
<FilesMatch "(?i)^(\.env.*|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|vite\.config\.js|.*\.md|.*\.ya?ml|.*\.sqlite|.*\.log)$">
    Require all denied
</FilesMatch>

# Directories holding code, configuration, dependencies or runtime state.
RedirectMatch 404 ^/(app|bootstrap|config|database|doc|deployment|node_modules|resources|routes|storage|tests|vendor)(/|$)

# ---------------------------------------------------------------------------
# Guard two: forward everything else into public/, where Laravel's front
# controller handles the request.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
