# SemantIQ cPanel front door.
#
# D-08B is in force and permanent: the cPanel document root is public_html, the
# deployment root is public_html, and the whole Laravel tree is deployed inside
# it. This file is therefore the security boundary, not a defence-in-depth
# extra. public_html/public is NOT part of the intended production architecture.
#
# EVERY rule below lives in mod_rewrite, deliberately. An earlier version mixed
# mod_rewrite with mod_alias RedirectMatch and mod_authz FilesMatch. Rules in a
# single module run in written order, so the denials genuinely precede the
# forwarder. The FilesMatch block afterwards is a second, independent mechanism.
#
# No RewriteBase, domain or absolute path, so the same file works across domains
# and subdomains.

# Denials must stay visible as 403.
#
# This is a security control, not cosmetics. Apache serves a denial through its
# ErrorDocument chain; a PATH-valued ErrorDocument re-enters the rewrite engine,
# meets the forwarder, lands in Laravel and returns 404 - which is exactly what
# happened here for weeks and led to the false conclusion that the deny rules
# were not firing at all. PR #38 proved they were: the rules executed, and only
# the reported status was wrong.
#
# A quoted LITERAL is answered from memory - no internal redirect, no rewrite
# pass, no Laravel - so the status arrives intact. The deployment's exposure
# gate now REQUIRES 403 on every protected path, so replacing this with a path
# would mask the boundary again and fail that gate. Keep it a literal.
#
# The text is deliberately bare: no framework name, version, server path, stack
# trace, configuration detail or internal marker.
ErrorDocument 403 "Forbidden"

<IfModule mod_rewrite.c>
    RewriteEngine On

    # FIRST, before any dotfile rule. .well-known carries the ACME challenge that
    # renews the TLS certificate; blocking it breaks HTTPS renewal silently,
    # weeks later, in a way nobody connects back to this file.
    RewriteRule ^\.well-known/ - [L]

    # Every other dotfile, at any depth: .env, .git, .gitignore and friends.
    RewriteRule (^|/)\. - [F,L]

    # Sensitive files by name, at any depth, so a file that moves does not
    # quietly lose its guard.
    RewriteRule (^|/)(composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|vite\.config\.js|[^/]*\.md|[^/]*\.ya?ml|[^/]*\.log|[^/]*\.sqlite)$ - [F,L]

    # Directories holding code, configuration, dependencies or runtime state.
    # A route may not begin with any of these; RoutePrefixCollisionTest enforces
    # that, because a URL this blocks is a URL the application cannot serve.
    RewriteRule ^(app|bootstrap|config|database|doc|deployment|node_modules|resources|routes|storage|tests|vendor)(/|$) - [F,L]

    # Everything that survives goes to Laravel's front controller.
    #
    # This forwarder is transitional. The permanent layout serves the
    # application directly from public_html/index.php with no public/ hop; that
    # migration is a separate, self-contained change.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Second, independent mechanism. Different module, so a mistake in the rewrite
# rules above does not silently disable this too. PR #38 confirmed <Files> +
# Require all denied is honoured on this host.
<FilesMatch "(?i)^(\.env.*|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|vite\.config\.js|.*\.md|.*\.ya?ml|.*\.sqlite|.*\.log)$">
    Require all denied
</FilesMatch>
